--- .gitignore (原始)
# Python
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual Environment
.venv/
venv/
env/
ENV/

# Django
*.log
db.sqlite3
db.sqlite3-journal
media/
staticfiles/

# Environment variables
.env
.env.*
!.env.example

# IDEs
.vscode/
.idea/
*.swp
*.swo

# macOS
.DS_Store

# Testing
.pytest_cache/
.coverage
htmlcov/

# Mypy
.mypy_cache/

# Ruff
.ruff_cache/

# Django migrations
# اگر migrationها را باید commit کنی، این بخش را فعال نکن
**/migrations/*
!**/migrations/__init__.py

# Build / distribution
build/
dist/
*.egg-info/

# Jupyter
.ipynb_checkpoints/

# Local development
*.sqlite3
*.sqlite3-journal

#redis
dump.rdb
*.rdb

